<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : 'Bartcam' %></title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_include_tag 'application', defer: true %>
  </head>
  <body>
    <div class="container">
      <nav class="navbar navbar-expand-md bg-body-tertiary">
        <a class="navbar-brand" href="/"><%= image_tag 'logo.png', alt: 'bartCAM' %></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Rozwiń menu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navigation">
          <div class="navbar-nav me-auto">
            <%= link_to 'na żywo', live_path, class: 'nav-link' %>
            <%= link_to 'nagrywanie', record_index_path, class: 'nav-link' %>
            <%= link_to 'archiwum', play_path, class: 'nav-link' %>
            <%= link_to 'konfiguracja', config_index_path, class: 'nav-link' %>
          </div>
          <%= button_to 'wylogowanie', account_logou_path, method: :delete, class: 'btn btn-outline-secondary' if current_user %>
        </div>
      </nav>
      <% flash.each do |key, value| %>
        <div class="<%= flash_class(key) %>"><%= value %></div>
      <% end %>
      <%= yield %>
      <footer id="footer"><p class="text-muted">&copy; BartCam</p></footer>
    </div>
  </body>
</html>
