<div class="row">
  <div class="col-md-4">
      <div class="list-group">
          <a href="#" class="list-group-item active">
              Kamery
            </a>

            <% Camera.where(:user_id => session[:user_id]).each do |list| %>
          <% if list.recording? %>

            <%= link_to "/live/#{list.id}", :class => "list-group-item" do %>
            <span class="badge bg-danger">rec</span> <%= list.name %>
            <% end %>

          <% else %>

            <%= link_to list.name,  "/live/#{list.id}", :class => "list-group-item" %>
          <% end %>
        <% end %>

        </div>
  </div><!-- /.col-sm-4 -->

    <div class="col-md-8">
    <h2><%= @camera.name %></h2>
    <%= image_tag @link, style: 'max-width:100%; margin:auto; display:block;', alt: 'Obraz z kamery' %>
  </div>
</div>
