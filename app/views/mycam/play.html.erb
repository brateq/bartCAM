<div class="row">
  <div class="col-md-4 list-group">
    <% current_user.cameras.each do |camera| %>
      <%= link_to camera.name, play_path(id: camera.id), class: 'list-group-item' %>
    <% end %>
    <% @files.each do |file| %>
      <%= link_to file, "/play/#{@camera.id}/#{ERB::Util.url_encode(file)}", class: 'list-group-item' %>
    <% end %>
  </div>
  <div class="col-md-8">
    <h1>Archiwum</h1>
    <h3><%= @camera.name %></h3>
    <% if @video %>
      <%= video_tag camera_video_path(id: @camera.id, filename: @video), controls: true, style: 'width:100%' %>
      <%= link_to 'Pobierz nagranie', camera_video_path(id: @camera.id, filename: @video), class: 'btn btn-secondary' %>
    <% end %>
  </div>
</div>
